---
import MainLayout from '@/layouts/MainLayout.astro';
import Container from '@/components/common/Container.astro';
import Button from '@/components/common/Button.astro';
import { Home } from 'lucide-astro';
---

<MainLayout
  title="Página no encontrada (404)"
  description="La página que estás buscando no existe o ha sido movida."
  noindex={true}
>
  <section class="py-24 sm:py-32 text-center">
    <Container class="max-w-md">
      <span class="inline-block px-3 py-1 text-xs font-bold text-brand-blue bg-blue-50 border border-blue-100 rounded-full mb-4">
        Error 404
      </span>
      <h1 class="text-4xl font-extrabold text-brand-navy tracking-tight mb-4">
        Página no encontrada
      </h1>
      <p class="text-brand-muted text-base mb-8 leading-relaxed">
        Lo sentimos, la página que buscas no existe o ha cambiado de dirección.
      </p>
      <Button href="/" variant="primary">
        <Home class="w-4 h-4 mr-2" />
        <span>Volver al inicio</span>
      </Button>
    </Container>
  </section>
</MainLayout>
