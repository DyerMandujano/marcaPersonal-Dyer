---
import MainLayout from '@/layouts/MainLayout.astro';
import Container from '@/components/common/Container.astro';
import SectionTitle from '@/components/common/SectionTitle.astro';
import { SERVICES } from '@/data/services';
---

<MainLayout
  title="Servicios de Desarrollo Web & Soluciones Digitales"
  description="Servicios profesionales de desarrollo web, landing pages, sistemas a medida, inteligencia de negocios y mantenimiento web."
>
  <section class="py-16 sm:py-20">
    <Container>
      <SectionTitle
        tag="Servicios Profesionales"
        title="Soluciones diseñadas para impulsar tu negocio"
        subtitle="Cada proyecto se diseña a la medida de tus necesidades comerciales, con altos estándares de rendimiento y usabilidad."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          SERVICES.map((service) => (
            <article class="p-6 bg-white border border-brand-border rounded-xl shadow-subtle hover:shadow-card-hover hover:border-blue-200 transition-all">
              <h3 class="text-xl font-bold text-brand-navy mb-2">{service.title}</h3>
              <p class="text-sm text-brand-muted mb-4">{service.shortDescription}</p>
              <ul class="space-y-1.5 text-xs text-slate-600 mb-6">
                {service.features.slice(0, 3).map((feature) => (
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-brand-blue"></span>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
              <a href="/contacto" class="text-xs font-semibold text-brand-blue hover:underline">
                Solicitar información &rarr;
              </a>
            </article>
          ))
        }
      </div>
    </Container>
  </section>
</MainLayout>
