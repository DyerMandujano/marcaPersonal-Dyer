---
import MainLayout from '@/layouts/MainLayout.astro';
import Container from '@/components/common/Container.astro';
import Badge from '@/components/common/Badge.astro';
import Button from '@/components/common/Button.astro';
import { PROJECTS } from '@/data/projects';
import type { Project } from '@/types/project';
import {
  ArrowLeft,
  Github,
  ExternalLink,
  CheckCircle2,
  AlertCircle,
  Lightbulb,
  Layers,
  ArrowRight,
  Clock,
} from 'lucide-astro';

export async function getStaticPaths() {
  return PROJECTS.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<MainLayout
  title={`${project.title} | Ficha Técnica`}
  description={project.description}
  image={project.image}
>
  <!-- Barra de navegación secundaria / Breadcrumb -->
  <div class="bg-white border-b border-brand-border py-4">
    <Container class="max-w-5xl">
      <a
        href="/proyectos"
        class="inline-flex items-center gap-2 text-sm font-semibold text-brand-muted hover:text-brand-blue transition-colors"
      >
        <ArrowLeft class="w-4 h-4" />
        <span>Volver al portafolio de proyectos</span>
      </a>
    </Container>
  </div>

  <article class="py-12 sm:py-20 bg-brand-bg">
    <Container class="max-w-5xl space-y-12">
      <!-- Encabezado del Proyecto -->
      <div class="p-8 sm:p-12 bg-white border border-brand-border rounded-3xl shadow-card space-y-6">
        <div class="flex flex-wrap items-center gap-2">
          <Badge variant="blue" size="md">{project.category}</Badge>
          {
            project.badge && (
              <Badge
                variant={project.projectType === 'académico' ? 'cyan' : 'neutral'}
                size="md"
              >
                {project.badge}
              </Badge>
            )
          }
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-brand-navy tracking-tight leading-tight">
          {project.title}
        </h1>

        <p class="text-base sm:text-lg text-brand-muted leading-relaxed max-w-3xl font-normal">
          {project.description}
        </p>

        <!-- Botones de Acción (Repo / Demo / Cotización) -->
        <div class="flex flex-wrap items-center gap-4 pt-4 border-t border-brand-border">
          {
            project.githubUrl && (
              <Button
                href={project.githubUrl}
                variant="outline"
                size="md"
                target="_blank"
                rel="noopener noreferrer"
              >
                <Github class="w-4 h-4 mr-2" />
                <span>Ver repositorio en GitHub</span>
              </Button>
            )
          }

          {
            project.liveUrl ? (
              <Button
                href={project.liveUrl}
                variant="primary"
                size="md"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>Ver demostración en vivo</span>
                <ExternalLink class="w-4 h-4 ml-2" />
              </Button>
            ) : (
              <div class="inline-flex items-center gap-1.5 px-3.5 py-2.5 text-xs font-semibold text-slate-500 bg-slate-100 rounded-xl border border-slate-200">
                <Clock class="w-3.5 h-3.5 text-slate-400" />
                <span>Demostración en vivo: disponible a solicitud</span>
              </div>
            )
          }

          <Button
            href={`/contacto?proyecto=${project.slug}`}
            variant="secondary"
            size="md"
          >
            <span>Cotizar un proyecto similar</span>
            <ArrowRight class="w-4 h-4 ml-2" />
          </Button>
        </div>
      </div>

      <!-- Imagen Principal del Proyecto -->
      <div class="rounded-3xl overflow-hidden border border-brand-border shadow-card bg-slate-900 aspect-[16/9]">
        <img
          src={project.image}
          alt={`Captura principal de ${project.title}`}
          class="w-full h-full object-cover object-top"
        />
      </div>

      <!-- Bloque Problema Identificado vs Solución Desarrollada -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Problema -->
        <div class="p-8 bg-white border border-brand-border rounded-3xl shadow-subtle space-y-4">
          <div class="flex items-center gap-2.5 text-brand-navy font-bold text-base">
            <div class="p-2 rounded-xl bg-amber-50 text-amber-600 border border-amber-200">
              <AlertCircle class="w-5 h-5" />
            </div>
            <span>Problema Identificado</span>
          </div>
          <p class="text-sm text-slate-600 leading-relaxed font-normal">
            {project.problemIdentified}
          </p>
        </div>

        <!-- Solución -->
        <div class="p-8 bg-white border border-brand-border rounded-3xl shadow-subtle space-y-4">
          <div class="flex items-center gap-2.5 text-brand-navy font-bold text-base">
            <div class="p-2 rounded-xl bg-blue-50 text-brand-blue border border-blue-200">
              <Lightbulb class="w-5 h-5" />
            </div>
            <span>Solución Desarrollada</span>
          </div>
          <p class="text-sm text-slate-600 leading-relaxed font-normal">
            {project.developedSolution}
          </p>
        </div>
      </div>

      <!-- Descripción Detallada y Funcionalidades -->
      <div class="p-8 sm:p-12 bg-white border border-brand-border rounded-3xl shadow-card space-y-8">
        <div>
          <h2 class="text-2xl font-bold text-brand-navy mb-4">
            Descripción y Enfoque Arquitectónico
          </h2>
          <p class="text-base text-slate-600 leading-relaxed">
            {project.longDescription}
          </p>
        </div>

        <div class="pt-8 border-t border-brand-border">
          <h2 class="text-2xl font-bold text-brand-navy mb-6">
            Funcionalidades Implementadas
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {
              project.features.map((feature) => (
                <div class="flex items-start gap-3 p-3.5 rounded-xl bg-slate-50 border border-slate-100">
                  <CheckCircle2 class="w-5 h-5 text-brand-blue flex-shrink-0 mt-0.5" />
                  <span class="text-sm text-slate-700 font-medium">{feature}</span>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Tecnologías Utilizadas -->
        <div class="pt-8 border-t border-brand-border">
          <div class="flex items-center gap-2 mb-4">
            <Layers class="w-5 h-5 text-brand-blue" />
            <h2 class="text-xl font-bold text-brand-navy">Tecnologías Utilizadas</h2>
          </div>
          <div class="flex flex-wrap gap-2">
            {
              project.tags.map((tag) => (
                <span class="px-3.5 py-1.5 text-xs font-semibold rounded-lg bg-slate-100 text-slate-800 border border-slate-200">
                  {tag}
                </span>
              ))
            }
          </div>
        </div>
      </div>

      <!-- CTA Inferior -->
      <div class="p-8 sm:p-10 rounded-3xl bg-brand-navy text-white flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <h3 class="text-xl font-bold text-white mb-2">
            ¿Necesitas una solución similar para tu negocio?
          </h3>
          <p class="text-sm text-slate-300">
            Conversemos sobre tu requerimiento y te preparo una propuesta personalizada.
          </p>
        </div>
        <Button href="/contacto" variant="primary" size="md" class="flex-shrink-0">
          <span>Solicitar cotización</span>
          <ArrowRight class="w-4 h-4 ml-2" />
        </Button>
      </div>
    </Container>
  </article>
</MainLayout>
