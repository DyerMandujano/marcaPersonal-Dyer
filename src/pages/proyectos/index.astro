---
import MainLayout from '@/layouts/MainLayout.astro';
import Container from '@/components/common/Container.astro';
import SectionTitle from '@/components/common/SectionTitle.astro';
import Badge from '@/components/common/Badge.astro';
import { PROJECTS } from '@/data/projects';
import { ArrowUpRight } from 'lucide-astro';
---

<MainLayout
  title="Portafolio de Proyectos Web & Sistemas"
  description="Proyectos desarrollados y en curso por Dyer Mandujano: plataformas web, sistemas administrativos y dashboards de analítica de datos."
>
  <section class="py-16 sm:py-20">
    <Container>
      <SectionTitle
        tag="Portafolio de Trabajo"
        title="Proyectos y soluciones desarrolladas"
        subtitle="Explora casos reales de desarrollo de software, plataformas web e inteligencia de negocios."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          PROJECTS.map((project) => (
            <article class="p-6 bg-white border border-brand-border rounded-xl shadow-subtle hover:shadow-card-hover transition-all flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <Badge variant="blue">{project.category}</Badge>
                  {project.status === 'en-desarrollo' && (
                    <Badge variant="neutral">En desarrollo</Badge>
                  )}
                </div>
                <h3 class="text-xl font-bold text-brand-navy mb-2">{project.title}</h3>
                <p class="text-sm text-brand-muted mb-4">{project.description}</p>
                <div class="flex flex-wrap gap-1.5 mb-6">
                  {project.tags.map((tag) => (
                    <span class="px-2 py-0.5 text-xs bg-slate-100 text-slate-600 rounded">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
              <div class="pt-4 border-t border-brand-border flex items-center justify-between">
                <a
                  href={`/proyectos/${project.slug}`}
                  class="text-xs font-semibold text-brand-blue hover:underline inline-flex items-center gap-1"
                >
                  <span>Ver detalles</span>
                  <ArrowUpRight class="w-3.5 h-3.5" />
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </Container>
  </section>
</MainLayout>
