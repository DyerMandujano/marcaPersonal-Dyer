---
import Container from '@/components/common/Container.astro';
import Button from '@/components/common/Button.astro';
import { siteConfig } from '@/config/site';
import { ArrowRight, MessageCircle, Sparkles } from 'lucide-astro';
---

<section class="py-20 lg:py-28 bg-brand-navy text-white relative overflow-hidden">
  <!-- Glowing subtle accents -->
  <div class="absolute inset-0 pointer-events-none opacity-25">
    <div class="absolute top-0 right-1/4 w-80 h-80 rounded-full bg-brand-blue blur-3xl"></div>
    <div class="absolute bottom-0 left-1/4 w-80 h-80 rounded-full bg-brand-cyan blur-3xl"></div>
  </div>

  <Container class="relative z-10 text-center max-w-4xl reveal-on-scroll">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-950/80 text-brand-cyan border border-blue-800/60 text-xs font-semibold uppercase tracking-wider mb-6">
      <Sparkles class="w-3.5 h-3.5" />
      <span>Hablemos de tu Próximo Proyecto</span>
    </div>

    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
      ¿Tienes una idea para tu negocio? <br class="hidden sm:inline" />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-300">
        Hagámoslo realidad
      </span>
    </h2>

    <p class="mt-6 text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
      Conversemos sobre tus requerimientos, resolvamos tus dudas técnicas y definamos la mejor estrategia digital para impulsar tu presencia en internet.
    </p>

    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
      <Button
        href="/contacto"
        variant="primary"
        size="lg"
        class="w-full sm:w-auto shadow-lg shadow-blue-600/30 font-semibold"
      >
        <span>Solicitar una cotización</span>
        <ArrowRight class="w-5 h-5 ml-2" />
      </Button>

      <Button
        href={siteConfig.social.whatsapp}
        variant="outline"
        size="lg"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto bg-slate-900/60 border-slate-700 text-slate-200 hover:bg-slate-800 hover:text-white"
      >
        <MessageCircle class="w-5 h-5 mr-2 text-emerald-400" />
        <span>Escríbeme por WhatsApp</span>
      </Button>
    </div>

    <!-- Garantías / Compromiso profesional -->
    <div class="mt-12 pt-8 border-t border-slate-800/80 flex flex-wrap items-center justify-center gap-6 text-xs text-slate-400">
      <span>• Respuesta en menos de 24 horas</span>
      <span>• Propuestas claras y transparentes</span>
      <span>• Sin compromisos iniciales</span>
    </div>
  </Container>
</section>
