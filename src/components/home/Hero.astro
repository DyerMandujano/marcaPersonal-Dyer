---
import Container from '@/components/common/Container.astro';
import Button from '@/components/common/Button.astro';
import Badge from '@/components/common/Badge.astro';
import { siteConfig } from '@/config/site';
import {
  ArrowRight,
  Sparkles,
  CheckCircle2,
  Terminal,
} from 'lucide-astro';
---

<section class="relative bg-brand-navy text-white overflow-hidden pt-12 pb-20 lg:pt-20 lg:pb-32 border-b border-slate-800">
  <!-- Subtle decorative background glow and grid -->
  <div class="absolute inset-0 pointer-events-none opacity-20">
    <div
      class="absolute -top-40 -left-40 w-96 h-96 rounded-full bg-brand-blue blur-3xl"
    ></div>
    <div
      class="absolute top-1/2 -right-40 w-96 h-96 rounded-full bg-brand-cyan blur-3xl"
    ></div>
    <div
      class="absolute inset-0"
      style="background-image: radial-gradient(#334155 1px, transparent 1px); background-size: 32px 32px;"
    ></div>
  </div>

  <Container class="relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      <!-- Columna Izquierda: Mensaje Comercial y Acciones -->
      <div class="lg:col-span-7 text-center lg:text-left space-y-6">
        <!-- Badge de Disponibilidad -->
        <div class="inline-flex items-center">
          <Badge variant="cyan" size="md" class="border-cyan-500/30 bg-cyan-950/40 text-cyan-300">
            <span class="relative flex h-2 w-2 mr-1">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-500"></span>
            </span>
            <span>{siteConfig.availability.label}</span>
          </Badge>
        </div>

        <!-- Título Principal -->
        <h1 class="text-3xl sm:text-5xl lg:text-5xl xl:text-6xl font-extrabold tracking-tight text-white leading-tight">
          Transformo ideas en <br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-cyan-300 to-blue-500">
            soluciones digitales
          </span> <br class="hidden sm:inline" />
          para impulsar tu negocio
        </h1>

        <!-- Subtítulo / Descripción -->
        <p class="text-base sm:text-lg lg:text-xl text-slate-300 max-w-2xl mx-auto lg:mx-0 leading-relaxed font-normal">
          Diseño y desarrollo páginas web modernas, sistemas personalizados y soluciones tecnológicas para emprendedores y empresas.
        </p>

        <!-- Botones de Acción -->
        <div class="pt-2 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
          <Button href="/contacto" variant="primary" size="lg" class="w-full sm:w-auto shadow-lg shadow-blue-600/30">
            <span>Solicitar cotización</span>
            <ArrowRight class="w-5 h-5 ml-2" />
          </Button>

          <Button href="#proyectos" variant="outline" size="lg" class="w-full sm:w-auto bg-slate-900/60 border-slate-700 text-slate-200 hover:bg-slate-800 hover:text-white">
            <span>Ver proyectos</span>
          </Button>
        </div>

        <!-- Puntos clave de valor -->
        <div class="pt-6 border-t border-slate-800/80 grid grid-cols-2 sm:grid-cols-3 gap-4 text-xs text-slate-300 text-left">
          <div class="flex items-center gap-2">
            <CheckCircle2 class="w-4 h-4 text-brand-cyan flex-shrink-0" />
            <span>Código limpio & escalable</span>
          </div>
          <div class="flex items-center gap-2">
            <CheckCircle2 class="w-4 h-4 text-brand-cyan flex-shrink-0" />
            <span>100% Diseño responsive</span>
          </div>
          <div class="flex items-center gap-2 col-span-2 sm:col-span-1">
            <CheckCircle2 class="w-4 h-4 text-brand-cyan flex-shrink-0" />
            <span>Enfoque en conversión</span>
          </div>
        </div>
      </div>

      <!-- Columna Derecha: Composición Tecnológica Visual -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          <!-- Glow exterior -->
          <div class="absolute -inset-1 bg-gradient-to-r from-brand-blue to-brand-cyan rounded-2xl blur-lg opacity-30"></div>

          <!-- Ventana de Código / Arquitectura Digital -->
          <div class="relative rounded-2xl bg-slate-900 border border-slate-700/80 shadow-2xl overflow-hidden">
            <!-- Barra de título de la ventana -->
            <div class="flex items-center justify-between px-4 py-3 bg-slate-950/80 border-b border-slate-800">
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-rose-500/90 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-amber-500/90 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-emerald-500/90 inline-block"></span>
                <span class="ml-2 text-xs font-mono text-slate-400">solution.config.ts</span>
              </div>
              <div class="flex items-center gap-1.5 text-xs text-brand-cyan font-mono">
                <Terminal class="w-3.5 h-3.5" />
                <span>v1.0.0</span>
              </div>
            </div>

            <!-- Contenido de la ventana de código -->
            <div class="p-5 font-mono text-xs sm:text-sm text-slate-300 space-y-2.5 overflow-x-auto">
              <div class="text-slate-500">// Soluciones tecnológicas personalizadas</div>
              <div>
                <span class="text-purple-400">const</span>{' '}
                <span class="text-blue-400">serviciosProfesionales</span> = {'{'}
              </div>
              <div class="pl-4">
                <span class="text-slate-400">web:</span>{' '}
                <span class="text-emerald-300">'Páginas Web Corporativas'</span>,
              </div>
              <div class="pl-4">
                <span class="text-slate-400">conversion:</span>{' '}
                <span class="text-emerald-300">'Landing Pages de Alto Impacto'</span>,
              </div>
              <div class="pl-4">
                <span class="text-slate-400">sistemas:</span>{' '}
                <span class="text-emerald-300">'Sistemas a Medida & Automatización'</span>,
              </div>
              <div class="pl-4">
                <span class="text-slate-400">analytics:</span>{' '}
                <span class="text-emerald-300">'Dashboards en Power BI & SQL'</span>,
              </div>
              <div class="pl-4">
                <span class="text-slate-400">rendimiento:</span>{' '}
                <span class="text-cyan-400">100</span>, <span class="text-slate-500">// Lighthouse Core Web Vitals</span>
              </div>
              <div>{'};'}</div>
              <div class="pt-2 text-slate-500">// Resultado garantizado para tu empresa</div>
              <div>
                <span class="text-purple-400">export default</span>{' '}
                <span class="text-cyan-300">impulsarCrecimiento</span>(serviciosProfesionales);
              </div>
            </div>

            <!-- Tarjeta inferior integrada: Monograma DM e indicadores de stack -->
            <div class="p-4 bg-slate-950 border-t border-slate-800 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-blue to-brand-cyan flex items-center justify-center font-bold text-white shadow-md">
                  DM
                </div>
                <div>
                  <div class="text-xs font-bold text-white">Dyer Mandujano</div>
                  <div class="text-[11px] text-slate-400">Desarrollo Web & Soluciones</div>
                </div>
              </div>

              <!-- Píldoras rápidas de stack -->
              <div class="flex items-center gap-1.5">
                <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-blue-950/60 text-blue-300 border border-blue-800/40">
                  Astro
                </span>
                <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-cyan-950/60 text-cyan-300 border border-cyan-800/40">
                  TypeScript
                </span>
                <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-slate-800 text-slate-300 border border-slate-700/40">
                  SQL
                </span>
              </div>
            </div>
          </div>

          <!-- Píldora flotante decorativa -->
          <div class="hidden sm:flex absolute -bottom-5 -left-5 bg-white text-brand-navy px-4 py-2.5 rounded-xl shadow-xl items-center gap-3 border border-slate-200">
            <div class="p-1.5 bg-blue-100 text-brand-blue rounded-lg">
              <Sparkles class="w-4 h-4" />
            </div>
            <div class="text-left">
              <div class="text-xs font-bold leading-tight">Enfoque Comercial</div>
              <div class="text-[10px] text-brand-muted">Diseñado para captar clientes</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
