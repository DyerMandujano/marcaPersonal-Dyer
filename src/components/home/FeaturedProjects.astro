---
import Container from '@/components/common/Container.astro';
import Badge from '@/components/common/Badge.astro';
import Button from '@/components/common/Button.astro';
import { PROJECTS } from '@/data/projects';
import { ArrowUpRight, Github } from 'lucide-astro';
---

<section id="proyectos" class="py-20 lg:py-28 bg-white border-y border-brand-border scroll-mt-20">
  <Container class="reveal-on-scroll">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 lg:mb-16 gap-6">
      <div class="max-w-2xl">
        <span class="inline-block px-3 py-1 mb-3 text-xs font-semibold tracking-wider uppercase rounded-full bg-blue-50 text-brand-blue border border-blue-100">
          Portafolio Destacado
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-brand-navy">
          Proyectos y Soluciones Desarrolladas
        </h2>
        <p class="mt-3 text-base sm:text-lg text-brand-muted leading-relaxed">
          Proyectos académicos y demostrativos que reflejan mis habilidades en desarrollo web, persistencia de datos y analítica.
        </p>
      </div>

      <div class="flex-shrink-0">
        <Button href="/proyectos" variant="outline" size="md">
          <span>Ver todos los proyectos</span>
          <ArrowUpRight class="w-4 h-4 ml-1.5" />
        </Button>
      </div>
    </div>

    <!-- Grid de Proyectos -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        PROJECTS.map((project) => (
          <article class="bg-white border border-brand-border rounded-2xl overflow-hidden shadow-subtle hover:shadow-card-hover transition-all duration-300 flex flex-col justify-between group hover:border-slate-300">
            <div>
              <!-- Imagen / Mockup del Proyecto -->
              <div class="relative overflow-hidden aspect-[16/10] bg-slate-900 border-b border-brand-border">
                <img
                  src={project.image}
                  alt={`Vista previa del proyecto ${project.title}`}
                  class="w-full h-full object-cover object-top group-hover:scale-102 transition-transform duration-300"
                  loading="lazy"
                />
                <div class="absolute top-3 left-3 flex flex-wrap gap-1.5">
                  <Badge variant="blue" size="sm">
                    {project.category}
                  </Badge>
                  {project.badge && (
                    <Badge variant={project.projectType === 'académico' ? 'cyan' : 'neutral'} size="sm">
                      {project.badge}
                    </Badge>
                  )}
                </div>
              </div>

              <!-- Contenido de la Tarjeta -->
              <div class="p-6">
                <h3 class="text-xl font-bold text-brand-navy mb-2 group-hover:text-brand-blue transition-colors">
                  {project.title}
                </h3>

                <p class="text-sm text-brand-muted leading-relaxed mb-6 font-normal">
                  {project.description}
                </p>

                <!-- Tags tecnológicos -->
                <div class="flex flex-wrap gap-1.5 mb-2">
                  {project.tags.map((tag) => (
                    <span class="px-2.5 py-1 text-xs font-medium rounded-md bg-slate-100 text-slate-700">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </div>

            <!-- Botones de Acción -->
            <div class="px-6 py-4 bg-slate-50/60 border-t border-brand-border flex items-center justify-between">
              <a
                href={`/proyectos/${project.slug}`}
                class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-blue hover:text-brand-blue-hover transition-colors"
              >
                <span>Ver detalles del proyecto</span>
                <ArrowUpRight class="w-4 h-4" />
              </a>

              {project.githubUrl && (
                <a
                  href={project.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-1.5 rounded-lg text-slate-500 hover:text-brand-navy hover:bg-slate-200/60 transition-colors"
                  aria-label={`Ver repositorio de ${project.title} en GitHub`}
                  title="Ver en GitHub"
                >
                  <Github class="w-4 h-4" />
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </Container>
</section>
