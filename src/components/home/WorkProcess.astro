---
import Container from '@/components/common/Container.astro';
import SectionTitle from '@/components/common/SectionTitle.astro';
import { Search, Layout, Code2, CheckCircle2 } from 'lucide-astro';

const steps = [
  {
    number: '01',
    title: 'Análisis de necesidades',
    description:
      'Reunión inicial para comprender a fondo los objetivos de tu negocio, tu público objetivo y los requerimientos técnicos y funcionales del proyecto.',
    icon: Search,
  },
  {
    number: '02',
    title: 'Diseño y prototipado',
    description:
      'Estructuración visual y prototipos de la interfaz, definiendo jerarquía, usabilidad y experiencia de usuario antes de pasar al código.',
    icon: Layout,
  },
  {
    number: '03',
    title: 'Desarrollo e implementación',
    description:
      'Programación con tecnologías modernas (Astro, TypeScript, Tailwind), garantizando código limpio, alto rendimiento, accesibilidad y diseño responsive.',
    icon: Code2,
  },
  {
    number: '04',
    title: 'Pruebas y entrega',
    description:
      'Control de calidad integral, validación en diferentes dispositivos y navegadores, puesta en producción y orientación para la gestión de tu web.',
    icon: CheckCircle2,
  },
];
---

<section id="metodologia" class="py-20 lg:py-28 bg-white border-b border-brand-border scroll-mt-20">
  <Container>
    <SectionTitle
      tag="Metodología de Trabajo"
      title="Cómo transformamos tu idea en una solución real"
      subtitle="Un proceso estructurado, transparente y paso a paso para asegurar resultados predecibles y de alta calidad."
    />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 relative mt-12">
      {
        steps.map((step, index) => {
          const StepIcon = step.icon;
          return (
            <div class="relative p-7 bg-brand-bg border border-brand-border rounded-2xl flex flex-col justify-between group hover:border-blue-300 hover:bg-white hover:shadow-card transition-all duration-300">
              <!-- Número de paso de agua -->
              <div class="flex items-center justify-between mb-6">
                <span class="text-3xl font-extrabold text-blue-200 group-hover:text-brand-blue transition-colors font-mono">
                  {step.number}
                </span>
                <div class="p-3 rounded-xl bg-white text-brand-navy border border-brand-border group-hover:bg-brand-blue group-hover:text-white transition-colors">
                  <StepIcon class="w-5 h-5" />
                </div>
              </div>

              <!-- Título y descripción -->
              <div>
                <h3 class="text-lg font-bold text-brand-navy mb-3">
                  {step.title}
                </h3>
                <p class="text-xs sm:text-sm text-brand-muted leading-relaxed font-normal">
                  {step.description}
                </p>
              </div>

              <!-- Indicador de avance -->
              <div class="mt-6 pt-4 border-t border-slate-200/60 flex items-center text-xs font-semibold text-slate-500 group-hover:text-brand-blue transition-colors">
                <span>Etapa {index + 1} de 4</span>
              </div>
            </div>
          );
        })
      }
    </div>
  </Container>
</section>
