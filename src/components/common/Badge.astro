---
interface Props {
  variant?: 'blue' | 'cyan' | 'neutral' | 'success';
  size?: 'sm' | 'md';
  class?: string;
}

const { variant = 'blue', size = 'sm', class: className = '' } = Astro.props;

const variantStyles = {
  blue: 'bg-blue-50 text-brand-blue border-blue-200',
  cyan: 'bg-cyan-50 text-cyan-800 border-cyan-200',
  neutral: 'bg-slate-100 text-slate-700 border-slate-200',
  success: 'bg-emerald-50 text-emerald-700 border-emerald-200',
};

const sizeStyles = {
  sm: 'px-2.5 py-0.5 text-xs',
  md: 'px-3 py-1 text-sm',
};
---

<span
  class={`inline-flex items-center gap-1.5 font-medium rounded-full border ${variantStyles[variant]} ${sizeStyles[size]} ${className}`}
>
  <slot />
</span>
