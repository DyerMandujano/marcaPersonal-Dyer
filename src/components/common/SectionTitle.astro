---
interface Props {
  tag?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  class?: string;
}

const { tag, title, subtitle, align = 'center', class: className = '' } = Astro.props;

const alignmentClasses = align === 'center' ? 'text-center mx-auto' : 'text-left';
---

<div class={`max-w-3xl mb-12 sm:mb-16 ${alignmentClasses} ${className}`}>
  {
    tag && (
      <span class="inline-block px-3 py-1 mb-3 text-xs font-semibold tracking-wider uppercase rounded-full bg-blue-50 text-brand-blue border border-blue-100">
        {tag}
      </span>
    )
  }
  <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-brand-navy">
    {title}
  </h2>
  {
    subtitle && (
      <p class="mt-4 text-base sm:text-lg text-brand-muted leading-relaxed">
        {subtitle}
      </p>
    )
  }
</div>
