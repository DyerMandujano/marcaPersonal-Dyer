---
import type { Service } from '@/types/service';

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<article class="p-6 bg-white border border-brand-border rounded-xl shadow-subtle hover:shadow-card-hover transition-all">
  <h3 class="text-xl font-bold text-brand-navy mb-2">{service.title}</h3>
  <p class="text-sm text-brand-muted">{service.shortDescription}</p>
</article>
