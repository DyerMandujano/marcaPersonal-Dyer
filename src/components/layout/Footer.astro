---
import { siteConfig } from '@/config/site';
import { FOOTER_LINKS } from '@/data/navigation';
import { Github, Linkedin, MessageCircle, Mail } from 'lucide-astro';

const currentYear = new Date().getFullYear();
---

<footer class="bg-brand-navy text-slate-300 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      <!-- Columna 1: Marca & Resumen -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <span
            class="flex items-center justify-center w-10 h-10 rounded-xl bg-brand-blue text-white font-bold text-base tracking-wider"
          >
            DM
          </span>
          <div class="flex flex-col">
            <span class="font-bold text-white text-lg tracking-tight">
              {siteConfig.name}
            </span>
            <span class="text-xs text-slate-400 font-medium">Desarrollo Web & Soluciones</span>
          </div>
        </div>
        <p class="text-sm text-slate-400 leading-relaxed">
          {siteConfig.description}
        </p>
        <div class="flex items-center gap-3 pt-2">
          <a
            href={siteConfig.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 rounded-lg bg-slate-800 text-slate-300 hover:text-white hover:bg-slate-700 transition-colors"
            aria-label="Perfil de GitHub"
          >
            <Github class="w-5 h-5" />
          </a>
          <a
            href={siteConfig.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 rounded-lg bg-slate-800 text-slate-300 hover:text-white hover:bg-slate-700 transition-colors"
            aria-label="Perfil de LinkedIn"
          >
            <Linkedin class="w-5 h-5" />
          </a>
          <a
            href={siteConfig.social.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 rounded-lg bg-slate-800 text-slate-300 hover:text-white hover:bg-slate-700 transition-colors"
            aria-label="Chat directo de WhatsApp"
          >
            <MessageCircle class="w-5 h-5" />
          </a>
          <a
            href={`mailto:${siteConfig.social.email}`}
            class="p-2 rounded-lg bg-slate-800 text-slate-300 hover:text-white hover:bg-slate-700 transition-colors"
            aria-label="Enviar correo electrónico"
          >
            <Mail class="w-5 h-5" />
          </a>
        </div>
      </div>

      <!-- Columna 2: Navegación -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white mb-4">
          Navegación
        </h3>
        <ul class="space-y-2.5 text-sm">
          {
            FOOTER_LINKS.navigation.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-slate-400 hover:text-white hover:underline transition-colors"
                >
                  {link.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Columna 3: Servicios -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white mb-4">
          Servicios
        </h3>
        <ul class="space-y-2.5 text-sm">
          {
            FOOTER_LINKS.services.map((service) => (
              <li>
                <a
                  href={service.href}
                  class="text-slate-400 hover:text-white hover:underline transition-colors"
                >
                  {service.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Columna 4: Disponibilidad y Contacto -->
      <div class="space-y-4">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white mb-4">
          Contacto Directo
        </h3>
        <div class="p-4 rounded-xl bg-slate-800/60 border border-slate-700/60 space-y-3">
          <div class="flex items-center gap-2">
            <span class="relative flex h-2.5 w-2.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
            </span>
            <span class="text-xs font-medium text-emerald-400">
              {siteConfig.availability.label}
            </span>
          </div>
          <p class="text-xs text-slate-400">
            ¿Tienes un proyecto o necesitas asesoría técnica? Hablemos sin compromiso.
          </p>
          <a
            href="/contacto"
            class="inline-block text-xs font-semibold text-brand-cyan hover:underline"
          >
            Solicitar cotización &rarr;
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="mt-12 pt-8 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <p>
        &copy; {currentYear} {siteConfig.name}. Todos los derechos reservados.
      </p>
      <p class="flex items-center gap-2">
        <span>Diseñado y construido con Astro & Tailwind CSS</span>
      </p>
    </div>
  </div>
</footer>
