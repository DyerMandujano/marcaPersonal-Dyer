---
import { NAV_ITEMS } from '@/data/navigation';
import Button from '@/components/common/Button.astro';
import MobileMenu from './MobileMenu.astro';
import { Menu } from 'lucide-astro';

const currentPath = Astro.url.pathname;
---

<header
  id="main-navbar"
  class="sticky top-0 z-40 w-full transition-all duration-200 bg-white/90 backdrop-blur-md border-b border-brand-border/80"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-brand-blue rounded-lg p-1">
        <span
          class="flex items-center justify-center w-10 h-10 rounded-xl bg-brand-navy text-white font-bold text-base tracking-wider shadow-sm group-hover:bg-brand-blue transition-colors duration-200"
        >
          DM
        </span>
        <div class="flex flex-col">
          <span class="font-bold text-brand-navy text-lg leading-tight tracking-tight group-hover:text-brand-blue transition-colors duration-200">
            Dyer Mandujano
          </span>
          <span class="text-xs text-brand-muted font-medium">Soluciones Digitales</span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center space-x-1" aria-label="Navegación principal">
        {
          NAV_ITEMS.map((item) => {
            const isActive =
              currentPath === item.href ||
              (item.href !== '/' && currentPath.startsWith(item.href));
            return (
              <a
                href={item.href}
                class={`px-4 py-2 rounded-lg text-sm font-medium transition-colors relative ${
                  isActive
                    ? 'text-brand-blue font-semibold bg-blue-50/60'
                    : 'text-slate-600 hover:text-brand-navy hover:bg-slate-100/60'
                }`}
                aria-current={isActive ? 'page' : undefined}
              >
                {item.title}
                {isActive && (
                  <span class="absolute bottom-1 left-4 right-4 h-0.5 bg-brand-blue rounded-full"></span>
                )}
              </a>
            );
          })
        }
      </nav>

      <!-- CTA & Mobile Toggle -->
      <div class="flex items-center gap-3">
        <div class="hidden sm:block">
          <Button href="/contacto" variant="primary" size="sm">
            <span>Hablemos</span>
          </Button>
        </div>

        <!-- Mobile hamburger button -->
        <button
          id="open-menu-btn"
          type="button"
          class="lg:hidden p-2 rounded-lg text-slate-600 hover:text-brand-navy hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-blue"
          aria-label="Abrir menú de navegación"
        >
          <Menu class="w-6 h-6" />
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer Component -->
  <MobileMenu currentPath={currentPath} />
</header>
