---
import { NAV_ITEMS } from '@/data/navigation';
import Button from '@/components/common/Button.astro';
import { Menu, ArrowRight } from 'lucide-astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
---

<header
  id="main-navbar"
  class="sticky top-0 z-40 w-full transition-all duration-300 bg-white/95 backdrop-blur-md border-b border-brand-border/80 shadow-sm"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo tipográfico DM + Nombre -->
      <a
        href="/"
        class="flex items-center gap-3.5 group focus:outline-none focus:ring-2 focus:ring-brand-blue rounded-xl p-1"
        aria-label="Dyer Mandujano - Inicio"
      >
        <span
          class="flex items-center justify-center w-11 h-11 rounded-xl bg-brand-navy text-white font-extrabold text-base tracking-wider shadow-sm group-hover:bg-brand-blue transition-colors duration-200 border border-slate-700/50"
        >
          DM
        </span>
        <div class="flex flex-col">
          <span class="font-extrabold text-brand-navy text-lg sm:text-xl leading-tight tracking-tight group-hover:text-brand-blue transition-colors duration-200">
            Dyer Mandujano
          </span>
          <span class="text-xs text-brand-muted font-medium tracking-wide">
            Desarrollo Web & Soluciones
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center space-x-1" aria-label="Navegación principal">
        {
          NAV_ITEMS.map((item) => {
            const isActive =
              currentPath === item.href ||
              (item.href !== '/' && currentPath.startsWith(item.href));
            return (
              <a
                href={item.href}
                class={`px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-200 relative ${
                  isActive
                    ? 'text-brand-blue bg-blue-50/80 shadow-xs'
                    : 'text-slate-600 hover:text-brand-navy hover:bg-slate-100/70'
                }`}
                aria-current={isActive ? 'page' : undefined}
              >
                {item.title}
                {isActive && (
                  <span class="absolute bottom-1 left-4 right-4 h-0.5 bg-brand-blue rounded-full"></span>
                )}
              </a>
            );
          })
        }
      </nav>

      <!-- Botón destacado: Solicitar cotización & Mobile Hamburger -->
      <div class="flex items-center gap-3">
        <div class="hidden sm:block">
          <Button href="/contacto" variant="primary" size="sm" class="shadow-sm">
            <span>Solicitar cotización</span>
            <ArrowRight class="w-4 h-4 ml-1.5" />
          </Button>
        </div>

        <!-- Botón menú móvil -->
        <button
          id="open-menu-btn"
          type="button"
          class="lg:hidden p-2.5 rounded-xl text-slate-700 hover:text-brand-navy hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-blue border border-transparent hover:border-brand-border"
          aria-label="Abrir menú de navegación"
          aria-expanded="false"
          aria-controls="mobile-menu-drawer"
        >
          <Menu class="w-6 h-6" />
        </button>
      </div>
    </div>
  </div>
</header>
